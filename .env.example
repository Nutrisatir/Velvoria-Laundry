CI_ENVIRONMENT = development
app.baseURL = 'http://localhost/VelvoriaLaundry/'
app.appTimezone = 'Asia/Jakarta'

# Session disimpan per-browser di tabel ci_sessions (MySQL).
# Jalankan php spark migrate sebelum login. Jangan gunakan satu cookie/session ID bersama.

database.default.hostname = localhost
database.default.database = velvoria_laundry
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# Midtrans Sandbox. Isi pada file .env lokal, BUKAN di source code.
# Server Key bersifat RAHASIA dan hanya digunakan backend.
# Client Key boleh dikirim ke browser untuk Snap.js.
MIDTRANS_SERVER_KEY = YOUR_SERVER_KEY
MIDTRANS_CLIENT_KEY = YOUR_CLIENT_KEY
midtrans.isProduction = false
midtrans.isSanitized = true
midtrans.is3ds = true

# SMTP untuk fitur lupa password. Isi dengan kredensial SMTP milik sendiri.
email.fromEmail = ''
email.fromName = 'Velvoria Laundry'
email.protocol = 'smtp'
email.SMTPHost = ''
email.SMTPUser = ''
email.SMTPPass = ''
email.SMTPPort = 587
email.SMTPCrypto = 'tls'
email.mailType = 'html'

# Akun admin pertama. Isi password kuat minimal 12 karakter sebelum seeding.
velvoria.adminEmail = 'admin@velvoria.test'
velvoria.adminName = 'Admin Velvoria'
velvoria.adminPhone = ''
velvoria.adminPassword = ''
